# ==========================================
# Konfigurasi Environment Binance Spot Bot
# ==========================================

# 1. Kredensial API Binance
BINANCE_API_KEY=masukkan_api_key_anda_di_sini
BINANCE_API_SECRET=masukkan_api_secret_anda_di_sini

# 2. Pengaturan Lingkungan
# 'production' untuk pasar riil, 'testnet' untuk uji coba (WAJIB dulu!)
ENVIRONMENT=testnet

# 3. Koin & Parameter Trading (DEFAULT — Swing Trading 1H / EMA Ribbon)
# Support multiple symbols comma-separated: BTCUSDT,ETHUSDT,SOLUSDT,NEARUSDT
SYMBOLS=SOLUSDT,NEARUSDT
TRADE_QTY=0.005
TIMEFRAME=1h                     # Default: 1H untuk swing trading dengan EMA Ribbon
RSI_PERIOD=14                    # Hanya dipakai di TIMEFRAME < 1h (mode RSI)
EMA_PERIOD=200                   # Hanya dipakai di TIMEFRAME < 1h (mode RSI)
OVERSOLD=30                      # Hanya dipakai di TIMEFRAME < 1h (mode RSI)
OVERBOUGHT=70                    # Hanya dipakai di TIMEFRAME < 1h (mode RSI)
STOP_LOSS_PCT=0.02

# 4. Order Confirmation & Timeout
ORDER_CONFIRM_TIMEOUT=30         # Detik tunggu konfirmasi order fill (polling /api/v3/orders)
API_TIMEOUT=10                   # Timeout koneksi REST API (detik)

# 5. Risk Management (PRODUCTION-GRADE)
# Force close posisi jika loss melebihi threshold ini (default 10% dari entry)
MAX_DRAWDOWN_PCT=0.10

# Partial Take Profit: jual separuh di target profit, sisanya trailing stop
USE_PARTIAL_TP=true
PARTIAL_TP_RATIO=0.5     # 0.5 = 50% posisi dijual di TP pertama
TRAILING_STOP_PCT=0.01   # Trailing stop 1% dari harga tertinggi (peak)

# 6. Database & Performance
DB_PATH=binance_bot.db
SL_FALLBACK_INTERVAL=30               # Interval cek SL via REST (detik, 0 = disable)

# 7. P1: Volume Spike Filter
VOLUME_FILTER=false                   # Default false — otomatis disabled saat mode ema_ribbon
VOLUME_MULT=2.0                       # Threshold multiplier (hanya aktif di mode RSI / <1h)

# 8. P1: EMA Trend Filter (hanya aktif di mode RSI / <1h)
EMA_TREND_FILTER=true                 # true = enable EMA slope check
EMA_TREND_BARS=5                      # Number of bars to check trend direction

# 9. P1: Take Profit Ratio (R:R configuration)
TP_MULT_SL=3.0                        # TP = SL% × this multiplier (3.0x = R:R 1:3)

# 10. P1: Dynamic ATR Stop Loss (experimental)
ATR_STOP_FRAC=0.0                     # ATR-based stop as fraction of ATR (0.0 = disabled, use fixed %)

# 11. P2: EMA Ribbon Strategy — DEFAULT MODE (1H swing trading)
# Auto-detected dari TIMEFRAME: 1h/4h/1d → ema_ribbon, <1h → rsi
# Override manual: STRATEGY_MODE=rsi atau STRATEGY_MODE=ema_ribbon
STRATEGY_MODE=ema_ribbon              # Default: EMA Ribbon Golden Cross untuk swing trading
EMA_FAST=8                            # Fast EMA — golden cross signal (optimal: 8/21/55)
EMA_MED=21                            # Medium EMA — trend baseline
EMA_SLOW=55                           # Slow EMA — trend confirmation

# 12. Notifikasi Telegram (opsional)
TELEGRAM_BOT_TOKEN=                   # Daftar di @BotFather → /newbot
TELEGRAM_CHAT_IDS=                    # Chat ID Anda (comma-sep untuk multi-chat)
TELEGRAM_NOTIFY_ERRORS=true            # false = skip notif error (hemat kuota)

# ==========================================
# CONTOH KONFIGURASI PRODUCTION (Default — 1H Swing Trading)
# ==========================================
# ENVIRONMENT=production
# SYMBOLS=SOLUSDT,NEARUSDT          # Best backtest symbols for 1H
# TRADE_QTY=0.002                   # Lebih kecil untuk diversifikasi
# STOP_LOSS_PCT=0.02                # SL 2% — optimal untuk SOL volatility
# TP_MULT_SL=3.0                    # R:R 1:3 — proven profitable
# STRATEGY_MODE=ema_ribbon          # Default, auto-detect dari TIMEFRAME=1h
# EMA_FAST=8 / EMA_MED=21 / EMA_SLOW=55
