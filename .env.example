# ==========================================
# Konfigurasi Environment Binance Spot Bot
# ==========================================

# 1. Kredensial API Binance
# Dapatkan ini dari menu API Management di akun Binance Anda
BINANCE_API_KEY=masukkan_api_key_anda_di_sini
BINANCE_API_SECRET=masukkan_api_secret_anda_di_sini

# 2. Pengaturan Lingkungan (Environment)
# Ubah ke 'production' jika menggunakan API utama Binance, 
# atau 'testnet' jika menggunakan Binance Spot Testnet (Sangat Disarankan untuk uji coba!)
ENVIRONMENT=testnet

# 3. (Opsional) Pengaturan Database
# Path untuk file database SQLite (jika tidak diisi, default akan menggunakan binance_bot.db di folder utama)
# DB_PATH=binance_bot.db