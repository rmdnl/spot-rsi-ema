# ==========================================
# Konfigurasi Environment Binance Spot Bot
# ==========================================

# 1. Kredensial API Binance
BINANCE_API_KEY=masukkan_api_key_anda_di_sini
BINANCE_API_SECRET=masukkan_api_secret_anda_di_sini

# 2. Pengaturan Lingkungan
# 'production' atau 'testnet'
ENVIRONMENT=testnet

# 3. Koin & Parameter Trading
SYMBOL=BTCUSDT
TRADE_QTY=0.005
TIMEFRAME=15m
RSI_PERIOD=14
EMA_PERIOD=200
OVERSOLD=30
OVERBOUGHT=70
STOP_LOSS_PCT=0.02

# 4. Database (opsional)
DB_PATH=binance_bot.db

# 5. Timeout REST API (detik)
API_TIMEOUT=10

# 6. Fallback SL interval (detik, 0 = disable)
SL_FALLBACK_INTERVAL=30
